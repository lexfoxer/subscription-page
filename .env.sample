APP_PORT=3010

### Remnawave Panel URL, can be http://remnawave:3000 or https://panel.example.com
REMNAWAVE_PANEL_URL=https://remnawave:3000
### Replace with own API Token. Create in Remnawave Dashboard → Remnawave Settings → API Tokens section 
REMNAWAVE_API_TOKEN=

# Serve at custom root path, for example, this value can be: CUSTOM_SUB_PREFIX=sub
# Do not place / at the start/end
CUSTOM_SUB_PREFIX=

# Express `trust proxy` setting, used so the real client IP is resolved from
# the trusted hop and cannot be spoofed via X-Forwarded-For. Accepts:
#   - "true" / "false"                          -> trust all / none
#   - a non-negative integer (e.g. 1, 2)        -> number of trusted hops
#   - a comma-separated list of preset names    -> loopback, linklocal, uniquelocal
#     and/or IP addresses / CIDR subnets        -> e.g. 127.0.0.1, 172.16.0.0/12
# See https://expressjs.com/en/guide/behind-proxies/
TRUST_PROXY=1

# If you use "Caddy with security" addon or "Tiny Auth", you can place here X-Api-Key, which will be applied to requests to Remnawave Panel.
# Will be used with "X-Api-Key" header
CADDY_AUTH_API_TOKEN=

# If you use Cloudflare Zero Trust
CLOUDFLARE_ZERO_TRUST_CLIENT_ID=""
CLOUDFLARE_ZERO_TRUST_CLIENT_SECRET=""

# Support Marzban links    
MARZBAN_LEGACY_LINK_ENABLED=false
MARZBAN_LEGACY_SECRET_KEY=

# Don't use this unless you know what you are doing!
# Example format: "2025-01-17T15:38:45.065Z"
MARZBAN_LEGACY_SUBSCRIPTION_VALID_FROM=

### ------------------------------------------------------------------
### Self-service settings page  (/<shortUuid>/settings)
### The page (and the gear icon) appears only when at least one of the
### features below is enabled.
### ------------------------------------------------------------------

# How many times per calendar month (UTC) a user may reset their own traffic
# counter from the subscription page. 0 disables the feature.
TRAFFIC_RESET_LIMIT_PER_MONTH=0

# Where the subscription page keeps its own data (SQLite file with the traffic
# reset history). Relative paths are resolved from the working directory
# (/opt/app in Docker). Mount a volume here, otherwise the monthly quota is
# forgotten on container recreation.
DATA_DIR=data

# External squads a user may pick for themselves. Two modes:
#
# 1) "auto" — managed from the Remnawave dashboard by squad names. A squad is
#    selectable when its name starts with tags in square brackets; the brackets
#    are hidden from users:
#      "[ios,macos,appletv] Apple servers"  -> recommended on Apple devices
#      "[android,windows,linux] Fast"       -> recommended on those platforms
#      "[all] Every server"                 -> suits any device
#      "[hidden] Experiments"               -> never shown
#      "Internal squad"                     -> never shown (no tags)
#    Tags: ios, android, macos (mac), windows (win), linux, androidtv (atv),
#    appletv (tvos), all. Case-insensitive, separated by comma or space.
#
# 2) JSON array with an explicit list:
#      uuid      - External squad UUID from Dashboard → External Squads
#      platforms - (optional) ios, android, macos, windows, linux, androidTV, appleTV
#      label     - (optional) name shown to the user instead of the squad name
#    EXTERNAL_SQUADS_SELECTABLE=[{"uuid":"c0f2...","platforms":["ios","macos","appleTV"],"label":"Apple devices"},{"uuid":"9a1b...","platforms":["android","windows","linux","androidTV"]}]
#
# Empty value disables squad selection.
EXTERNAL_SQUADS_SELECTABLE=auto

# Allow the user to switch back to "no external squad" (Remnawave default).
EXTERNAL_SQUADS_ALLOW_DEFAULT=false
